t": "2026-09-21T04:24:40Z", "body": "# Metrics a scraper can actually read, Mod-Gearman, and a much smaller install  \r\n  \r\n0.22.0 rebuilds the metrics side of the agent. `/api/v2/openmetrics` served the  \r\nJSON keys verbatim \u2014 names with dots, spaces and colons in them, no types, no  \r\nhelp text, six significant digits \u2014 which a strict parser rejected outright.  \r\nIt now serves a conformant, self-describing OpenMetrics document: every family  \r\nnamed to the grammar, typed, described, carrying its unit, and per-instance  \r\nreadings ", "assets": [{"name": "NSCP-0.22.0-ARM64-symbols.zip", "url": "https://github.com/mickem/nscp/releases/download/0.22.0/NSCP-0.22.0-ARM64-symbols.zip", "size": 11438606}, {"name": "NSCP-0.22.0-ARM64.msi", "url": "https://github.com/mickem/nscp/releases/download/0.22.0/NSCP-0.22.0-ARM64.msi", "size": 26333184}, {"name": "NSCP-0.22.0-ARM64.zip", "url": "https://github.com/mickem/nscp/releases/download/0.22.0/NSCP-0.22.0-ARM64.zip", "size": 32757023}, {"name": "NSCP-0.22.0-debian-trixie-arm64.deb", "url": "https://github.com/mickem/nscp/releases/download/0.22.0/NSCP-0.22.0-debian-trixie-arm64.deb", "size": 24500744}, {"name": "NSCP-0.22.0-docs.zip", "url": "https://github.com/mickem/nscp/releases/download/0.22.0/NSCP-0.22.0-docs.zip", "size": 4053106}, {"name": "NSCP-0.22.0-rocky-10-aarch64.rpm", "url": "https://github.com/mickem/nscp/releases/download/0.22.0/NSCP-0.22.0-rocky-10-aarch64.rpm", "size": 14814165}, {"name": "NSCP-0.22.0-rocky-10-x86_64.rpm", "url": "https://github.com/mickem/nscp/releases/download/0.22.0/NSCP-0.22.0-rocky-10-x86_64.rpm", "size": 15670748}, {"name": "NSCP-0.22.0-rocky-9-aarch64.rpm", "url": "https://github.com/mickem/nscp/releases/download/0.22.0/NSCP-0.22.0-rocky-9-aarch64.rpm", "size": 14692535}, {"name": "NSCP-0.22.0-rocky-9-x86_64.rpm", "url": "https://github.com/mickem/nscp/releases/download/0.22.0/NSCP-0.22.0-rocky-9-x86_64.rpm", "size": 15182601}, {"name": "NSCP-0.22.0-ubuntu-24.04-